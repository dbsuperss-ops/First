<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DupeFinderPro.ViewModels.Duplicate"
             x:Class="DupeFinderPro.Views.Duplicate.ResultsView"
             x:DataType="vm:ResultsViewModel">

    <Grid ColumnDefinitions="*, Auto">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  메인 콘텐츠                                               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="0" Margin="32 28">

            <!-- ── 헤더 ──────────────────────────────────────────── -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto"
                  Margin="0 0 0 20">
                <StackPanel Spacing="4">
                    <TextBlock Classes="page-title" Text="결과"/>
                    <TextBlock Classes="muted" Text="{Binding ScanName}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="danger" Content="취소"
                            Command="{Binding CancelScanCommand}"
                            IsVisible="{Binding IsScanning}"/>
                    <Button Classes="secondary" Content="전체 선택"
                            Command="{Binding CheckAllCommand}"
                            IsVisible="{Binding HasResults}"
                            ToolTip.Tip="모든 파일의 체크박스를 선택합니다"/>
                    <Button Classes="secondary" Content="전체 삭제"
                            Command="{Binding SetAllDeleteCommand}"
                            IsVisible="{Binding HasResults}"
                            ToolTip.Tip="체크된 파일(Keep 제외)을 삭제로 설정"/>
                    <Button Classes="secondary" Content="전체 격리"
                            Command="{Binding SetAllQuarantineCommand}"
                            IsVisible="{Binding HasResults}"
                            ToolTip.Tip="체크된 파일(Keep 제외)을 격리로 설정"/>
                    <Button Classes="secondary" Content="전체 이동"
                            Command="{Binding SetAllMoveCommand}"
                            IsVisible="{Binding HasResults}"
                            ToolTip.Tip="체크된 파일(Keep 제외)을 이동으로 설정"/>
                    <Button Classes="danger" Content="중복 삭제"
                            Command="{Binding DeleteDuplicatesCommand}"
                            IsVisible="{Binding HasResults}"
                            IsEnabled="{Binding !IsApplying}"
                            ToolTip.Tip="각 그룹에서 1개만 남기고 나머지를 즉시 삭제합니다"/>
                    <Button Classes="primary" Content="전체 적용"
                            Command="{Binding ApplyAllCommand}"
                            IsVisible="{Binding HasResults}"
                            IsEnabled="{Binding !IsApplying}"/>
                </StackPanel>
            </Grid>

            <!-- ── 스캔 진행 패널 ────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Classes="card" Margin="0 0 0 16"
                    IsVisible="{Binding IsScanning}">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="{Binding PhaseLabel}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding ProgressMax}"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Height="8" CornerRadius="4"
                                 Foreground="{StaticResource AccentTealBrush}"/>
                    <SelectableTextBlock Classes="muted" Text="{Binding CurrentFile}"
                                       TextWrapping="Wrap" MaxWidth="600"/>
                </StackPanel>
            </Border>

            <!-- ── 오류 패널 ─────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Background="#FFF5F5" CornerRadius="8"
                    Padding="14 12" Margin="0 0 0 16"
                    IsVisible="{Binding HasScanError}">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{StaticResource StatusRedBrush}"
                               FontWeight="SemiBold" Text="스캔 실패"/>
                    <SelectableTextBlock Foreground="{StaticResource StatusRedBrush}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── 요약 바 ────────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Classes="card" Margin="0 0 0 16"
                    IsVisible="{Binding HasResults}">
                <StackPanel Orientation="Horizontal" Spacing="32">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="중복 그룹"/>
                        <SelectableTextBlock FontSize="22" FontWeight="Bold"
                                             Foreground="{StaticResource AccentTealBrush}"
                                             Text="{Binding TotalGroups}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="검색된 파일"/>
                        <SelectableTextBlock FontSize="22" FontWeight="Bold"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Text="{Binding TotalFiles}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="낭비 공간"/>
                        <SelectableTextBlock FontSize="22" FontWeight="Bold"
                                             Foreground="{StaticResource StatusOrangeBrush}"
                                             Text="{Binding TotalWasted}"/>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Classes="muted" Text="소요 시간"/>
                        <SelectableTextBlock FontSize="22" FontWeight="Bold"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Text="{Binding ScanDuration}"/>
                    </StackPanel>

                    <!-- 격리 폴더 -->
                    <StackPanel Spacing="2" Margin="16 0 0 0">
                        <TextBlock Classes="label" Text="격리 폴더"/>
                        <Button Classes="secondary" Padding="8 4"
                                Click="BrowseQuarantineFolder_Click"
                                ToolTip.Tip="{Binding QuarantinePath}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding QuarantineFolderName}"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 이동 대상 폴더 -->
                    <StackPanel Spacing="2" Margin="8 0 0 0">
                        <TextBlock Classes="label" Text="이동 대상 폴더"/>
                        <Button Classes="secondary" Padding="8 4"
                                Click="BrowseMoveToFolder_Click"
                                ToolTip.Tip="{Binding MoveToPath}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MoveToFolderName}"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 정렬 / 필터 바 ─────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Classes="card" Margin="0 0 0 12"
                    IsVisible="{Binding HasResults}">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Classes="muted" Text="정렬:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Static vm:ResultsViewModel.SortModeLabels}"
                              SelectedItem="{Binding SelectedSortMode}"
                              MinWidth="110"/>
                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="4 0"/>
                    <TextBlock Classes="muted" Text="확장자:" VerticalAlignment="Center"/>
                    <TextBox Classes="input" MinWidth="80" MaxWidth="100"
                             Text="{Binding FilterExtension}"
                             Watermark="예) jpg"/>
                    <TextBlock Classes="muted" Text="최소 낭비 (MB):" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding FilterMinSizeMb}"
                                   Minimum="0" Increment="10" FormatString="0"
                                   MinWidth="90"/>
                </StackPanel>
            </Border>

            <!-- ── 중복 없음 ─────────────────────────────────────── -->
            <Border DockPanel.Dock="Top" Classes="card"
                    IsVisible="{Binding IsEmpty}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8" Margin="0 24">
                    <TextBlock FontSize="40" HorizontalAlignment="Center" Text="✓"/>
                    <TextBlock Classes="section-title" HorizontalAlignment="Center"
                               Text="중복 파일이 없습니다!"/>
                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                               Text="검색된 폴더에 중복 파일이 없습니다."/>
                </StackPanel>
            </Border>

            <!-- ── 중복 그룹 목록 ─────────────────────────────────── -->
            <ScrollViewer IsVisible="{Binding HasResults}">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                            <Border Classes="card" Margin="0 0 0 12"
                                    BorderBrush="{StaticResource AccentTealBrush}"
                                    BorderThickness="4 0 0 0">
                                <StackPanel Spacing="0">

                                    <!-- 그룹 헤더 (연한 teal 배경) -->
                                    <Border Background="#E8FDF8"
                                            CornerRadius="8 8 0 0"
                                            Margin="-20 -20 -20 12"
                                            Padding="12 10">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <!-- 그룹 체크박스 -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsGroupChecked}"
                                                      VerticalAlignment="Center"
                                                      Margin="0 0 8 0"/>

                                            <!-- 그룹 번호 배지 -->
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource AccentTealBrush}"
                                                    CornerRadius="12"
                                                    Padding="10 3"
                                                    Margin="0 0 10 0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GroupLabel}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="13"/>
                                            </Border>

                                            <!-- 접기/펼치기 버튼 -->
                                            <Button Grid.Column="2"
                                                    Background="Transparent"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0"
                                                    Command="{Binding ToggleExpandedCommand}">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="muted" Text="해시:"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock FontFamily="Cascadia Code,Consolas,monospace"
                                                                   Text="{Binding Hash}"
                                                                   Foreground="{StaticResource AccentTealBrush}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="muted"
                                                               Text="{Binding FileCount}"
                                                               VerticalAlignment="Center"
                                                               Margin="16 0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Foreground="{StaticResource StatusOrangeBrush}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding WastedBytes}"
                                                               VerticalAlignment="Center"
                                                               Margin="0 0 16 0"/>
                                                    <Button Grid.Column="3" Classes="secondary"
                                                            Content="자동 선택"
                                                            Command="{Binding AutoSelectCommand}"
                                                            Padding="10 4" Margin="0 0 8 0"/>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding ExpandIcon}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- 파일 행 -->
                                    <ItemsControl ItemsSource="{Binding Files}"
                                                  IsVisible="{Binding IsExpanded}"
                                                  Margin="0 8 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                                <Border Padding="8 10"
                                                        BorderThickness="0 1 0 0"
                                                        BorderBrush="{StaticResource BorderBrush}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,120,188">

                                                        <!-- 파일 체크박스 -->
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0 0 8 0"/>

                                                        <!-- 파일명 + 경로 (클릭 → 미리보기) -->
                                                        <StackPanel Grid.Column="1" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <Button Background="Transparent"
                                                                    Padding="0"
                                                                    HorizontalContentAlignment="Left"
                                                                    Command="{Binding $parent[UserControl].DataContext.SelectFileCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <TextBlock Classes="label"
                                                                           Text="{Binding FileName}"/>
                                                            </Button>
                                                            <SelectableTextBlock Classes="muted"
                                                                                 Text="{Binding FullPath}"
                                                                                 TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <!-- 크기 + 날짜 -->
                                                        <StackPanel Grid.Column="2"
                                                                    Spacing="2" Margin="16 0">
                                                            <TextBlock Classes="label"
                                                                       Text="{Binding SizeFormatted}"/>
                                                            <TextBlock Classes="muted"
                                                                       Text="{Binding LastModified}"/>
                                                        </StackPanel>

                                                        <!-- 처리 상태 -->
                                                        <SelectableTextBlock Grid.Column="3"
                                                                             Classes="muted"
                                                                             Text="{Binding StatusMessage}"
                                                                             VerticalAlignment="Center"
                                                                             HorizontalAlignment="Center"
                                                                             IsVisible="{Binding IsDone}"/>

                                                        <!-- 작업 버튼 (즉시 처리) -->
                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding !IsDone}">
                                                            <Button Padding="8 4"
                                                                    FontSize="12"
                                                                    Content="유지"
                                                                    Background="#E6FFF5"
                                                                    Foreground="{StaticResource StatusGreenBrush}"
                                                                    Command="{Binding SetActionKeepCommand}"/>
                                                            <Button Padding="8 4"
                                                                    FontSize="12"
                                                                    Content="이동"
                                                                    Background="#EBF8FF"
                                                                    Foreground="{StaticResource StatusBlueBrush}"
                                                                    Command="{Binding SetActionMoveCommand}"/>
                                                            <Button Padding="8 4"
                                                                    FontSize="12"
                                                                    Content="격리"
                                                                    ToolTip.Tip="격리 폴더로 이동"
                                                                    Background="#FFFAF0"
                                                                    Foreground="{StaticResource StatusOrangeBrush}"
                                                                    Command="{Binding SetActionQuarantineCommand}"/>
                                                            <Button Padding="8 4"
                                                                    FontSize="12"
                                                                    Content="삭제"
                                                                    Background="#FFF5F5"
                                                                    Foreground="{StaticResource StatusRedBrush}"
                                                                    Command="{Binding SetActionDeleteCommand}"/>
                                                        </StackPanel>

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  미리보기 패널 (파일명 클릭 시 표시)                        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Width="280"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1 0 0 0"
                IsVisible="{Binding HasSelectedFile}">
            <ScrollViewer>
                <StackPanel Margin="16" Spacing="12">

                    <TextBlock Classes="section-title" Text="미리보기"/>

                    <!-- 이미지 미리보기 -->
                    <Border CornerRadius="8" ClipToBounds="True"
                            IsVisible="{Binding IsImagePreview}">
                        <Image Source="{Binding PreviewBitmap}"
                               MaxHeight="240"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- 비이미지 파일 아이콘 -->
                    <TextBlock Text="📄" FontSize="52"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !IsImagePreview}"/>

                    <!-- 파일 정보 -->
                    <StackPanel Spacing="6">
                        <SelectableTextBlock Classes="label"
                                             Text="{Binding SelectedFile.FileName}"
                                             TextWrapping="Wrap"/>
                        <SelectableTextBlock Classes="muted"
                                             Text="{Binding SelectedFile.FullPath}"
                                             TextWrapping="Wrap"
                                             FontSize="11"/>

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0 4"/>

                        <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Classes="muted" Text="크기"/>
                            <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                                 Classes="label"
                                                 Text="{Binding SelectedFile.SizeFormatted}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Classes="muted" Text="수정일"/>
                            <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                                 Classes="muted"
                                                 Text="{Binding SelectedFile.LastModified}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Classes="muted" Text="생성일"/>
                            <SelectableTextBlock Grid.Row="2" Grid.Column="1"
                                                 Classes="muted"
                                                 Text="{Binding SelectedFile.CreatedAt}"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
