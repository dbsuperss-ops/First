<Window x:Class="AttendanceGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="출석부 생성기"
        Height="640" Width="520"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <TextBlock Grid.Row="0" Text="출석부 자동 생성기"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   Margin="0,0,0,20"/>

        <!-- 명단 파일 선택 -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="① 명단 파일 선택"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRosterPath"
                             materialDesign:HintAssist.Hint="출석부_TEMP.xlsx 경로"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             IsReadOnly="True" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="파일 선택"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="BtnSelectFile_Click"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 기간 설정 -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="② 기간 설정"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="DpStart"
                                materialDesign:HintAssist.Hint="시작일"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Grid.Column="0" Margin="0,0,8,0"/>
                    <TextBlock Text="~" Grid.Column="1" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontSize="16"/>
                    <DatePicker x:Name="DpEnd"
                                materialDesign:HintAssist.Hint="종료일"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Grid.Column="2"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 출력 폴더 -->
        <materialDesign:Card Grid.Row="3" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="③ 저장 폴더"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputDir"
                             materialDesign:HintAssist.Hint="출석부가 저장될 폴더"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             IsReadOnly="True" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="폴더 선택"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="BtnSelectOutput_Click"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 생성 버튼 + 프로그레스 -->
        <materialDesign:Card Grid.Row="4" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <Button x:Name="BtnGenerate"
                        Content="🚀 전체 출석부 일괄 생성"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="44" FontSize="15"
                        Click="BtnGenerate_Click"
                        Margin="0,0,0,10"/>
                <ProgressBar x:Name="PbProgress"
                             Minimum="0" Maximum="100" Value="0"
                             Height="8"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Text=""
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 결과 로그 -->
        <materialDesign:Card Grid.Row="5" Margin="0,0,0,12" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="생성 결과"
                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           Margin="8,4,0,4"/>
                <ListBox x:Name="LbResults" Grid.Row="1"
                         MinHeight="120" MaxHeight="160"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent"/>
            </Grid>
        </materialDesign:Card>

        <!-- 하단 버튼 -->
        <Button Grid.Row="6"
                x:Name="BtnOpenFolder"
                Content="📂 저장 폴더 열기"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                HorizontalAlignment="Right"
                IsEnabled="False"
                Click="BtnOpenFolder_Click"/>
    </Grid>
</Window>
