<Window x:Class="AttendanceGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="출석부 관리 시스템"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <DockPanel>

        <!-- ── 툴바 ──────────────────────────────────────────────── -->
        <ToolBar DockPanel.Dock="Top"
                 Style="{StaticResource MaterialDesignToolBar}"
                 ClipToBounds="False">

            <Button Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="파일 열기 (.att)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderOpen" Margin="0,0,4,0"/>
                    <TextBlock Text="열기"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="파일 저장 (.att)">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0"/>
                    <TextBlock Text="저장"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding GenerateDatesCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="기간과 요일로 수업일 자동 생성">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarRefresh" Margin="0,0,4,0"/>
                    <TextBlock Text="날짜 생성"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding AddStudentCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="학생 행 추가">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,4,0"/>
                    <TextBlock Text="학생 추가"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding RemoveLastStudentCommand}"
                    Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="마지막 학생 행 삭제">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountMinus" Margin="0,0,4,0"/>
                    <TextBlock Text="마지막 행 삭제"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- ── 상태 표시줄 ────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource MaterialDesignToolBarBackground}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Margin="8,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Students.Count, StringFormat='총 {0}명'}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Margin="8,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── 메인 컨텐츠 ────────────────────────────────────────── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 프로그램 정보 카드 ──────────────────────────── -->
            <materialDesign:Card Grid.Row="0" Margin="8,8,8,4" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: 기본 정보 -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Bottom">
                            <TextBlock Text="연도" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     materialDesign:HintAssist.Hint="YYYY"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Bottom">
                            <TextBlock Text="구분" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding Category}"
                                      Width="90"
                                      materialDesign:HintAssist.Hint="구분"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Bottom">
                            <TextBlock Text="프로그램명" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160"
                                     materialDesign:HintAssist.Hint="예: 한자, 독서논술"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Bottom">
                            <TextBlock Text="강사" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <TextBox Text="{Binding Teacher, UpdateSourceTrigger=PropertyChanged}"
                                     Width="100"
                                     materialDesign:HintAssist.Hint="강사명"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Row 2: 기간 / 요일 -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8" VerticalAlignment="Bottom">
                            <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <DatePicker SelectedDate="{Binding StartDate}"
                                        Width="130"
                                        materialDesign:HintAssist.Hint="시작일"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                            <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0" FontSize="16"/>
                            <DatePicker SelectedDate="{Binding EndDate}"
                                        Width="130"
                                        materialDesign:HintAssist.Hint="종료일"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="16,0,8,8" VerticalAlignment="Bottom">
                            <TextBlock Text="요일" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                            <ComboBox ItemsSource="{Binding Weekdays}"
                                      SelectedItem="{Binding Weekday}"
                                      Width="70"
                                      materialDesign:HintAssist.Hint="요일"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>

                        <Button Command="{Binding GenerateDatesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="8,0,0,8" VerticalAlignment="Bottom"
                                Content="날짜 자동 생성"/>
                    </WrapPanel>

                    <!-- Row 3: 결재란 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="결재" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"/>

                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1" Margin="0,0,0,0" Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="담당" HorizontalAlignment="Center"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBox Text="{Binding Approver1, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" TextAlignment="Center"
                                         Style="{StaticResource MaterialDesignTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1" Margin="4,0,0,0" Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="팀장" HorizontalAlignment="Center"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBox Text="{Binding Approver2, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" TextAlignment="Center"
                                         Style="{StaticResource MaterialDesignTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1" Margin="4,0,0,0" Padding="8,4">
                            <StackPanel>
                                <TextBlock Text="교장" HorizontalAlignment="Center"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBox Text="{Binding Approver3, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" TextAlignment="Center"
                                         Style="{StaticResource MaterialDesignTextBox}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ── 출석 DataGrid ──────────────────────────────────── -->
            <DataGrid x:Name="AttendanceGrid"
                      Grid.Row="1"
                      Margin="8,4,8,8"
                      ItemsSource="{Binding Students}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="Cell"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="False"
                      GridLinesVisibility="All"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ColumnHeaderHeight="36"
                      RowHeight="32"
                      FontSize="13">

                <DataGrid.Columns>
                    <!-- 고정 앞 컬럼 -->
                    <DataGridTextColumn Header="순번"
                                        Binding="{Binding Order}"
                                        Width="48" IsReadOnly="True"/>
                    <DataGridTextColumn Header="이름"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        Width="72"/>
                    <DataGridTextColumn Header="학년"
                                        Binding="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                        Width="48"/>
                    <DataGridTextColumn Header="반"
                                        Binding="{Binding Class, UpdateSourceTrigger=PropertyChanged}"
                                        Width="48"/>
                    <DataGridTextColumn Header="참여요일"
                                        Binding="{Binding ParticipationDay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="68"/>

                    <!-- 동적 날짜 컬럼은 MainWindow.xaml.cs에서 삽입 -->

                    <!-- 고정 뒷 컬럼 -->
                    <DataGridTextColumn Header="총출석"
                                        Binding="{Binding TotalPresent}"
                                        Width="56" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="지각"
                                        Binding="{Binding TotalLate}"
                                        Width="44" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#E65100"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="결석"
                                        Binding="{Binding TotalAbsent}"
                                        Width="44" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#B71C1C"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="연락처"
                                        Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110"/>
                    <DataGridTextColumn Header="비고"
                                        Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
