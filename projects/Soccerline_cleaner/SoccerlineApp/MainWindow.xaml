<Window x:Class="SoccerlineApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoccerlineApp"
        mc:Ignorable="d"
        Title="Soccerline Smart Crawler v0.6" Height="820" Width="1400"
        Icon="/soccerline_icon.ico"
        Background="{StaticResource BrushBgMain}">
    <Window.Resources>
        <!-- 컬럼 헤더 템플릿: 제목 + ▼ 필터 버튼 -->
        <Style x:Key="FilterHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Section -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurfaceCard}" BorderBrush="#222" BorderThickness="0,0,1,0">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Button x:Name="btnResume" Content="↻  RESUME" Style="{StaticResource PrimaryHero}" Height="40" Margin="0,0,0,8" Click="btnResume_Click"
                            ToolTip="중단된 작업 이어가기" IsEnabled="False"/>
                    <Button x:Name="btnStart" Content="▶  START LIST" Style="{StaticResource PrimaryHero}" Height="44" Margin="0,0,0,12" Click="btnStart_Click"
                            ToolTip="목록 페이지만 수집 (상세 방문 없음, 빠름)"/>
                    <Button x:Name="btnFetchDetails" Content="⇣  FETCH DETAILS" Style="{StaticResource PrimaryHero}" Height="44" Margin="0,0,0,12" Click="btnFetchDetails_Click"
                            ToolTip="체크된 행만 상세(본문/댓글/IP) 수집" IsEnabled="False"/>
                    <Button x:Name="btnStop" Content="■  STOP" Style="{StaticResource DangerHero}" Height="40" Margin="0,0,0,16" Click="btnStop_Click"/>

                    <TextBlock Text="Selection" Style="{StaticResource BodySmall}" Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSelAll" Content="All" Click="btnSelAll_Click" Background="Transparent" Foreground="White" BorderBrush="#444" BorderThickness="1" Padding="8,2" Margin="0,0,6,0"/>
                        <Button x:Name="btnSelNone" Content="None" Click="btnSelNone_Click" Background="Transparent" Foreground="White" BorderBrush="#444" BorderThickness="1" Padding="8,2" Margin="0,0,6,0"/>
                        <Button x:Name="btnSelFiltered" Content="Filtered" Click="btnSelFiltered_Click" Background="Transparent" Foreground="White" BorderBrush="#444" BorderThickness="1" Padding="8,2"/>
                    </StackPanel>
                    <TextBlock x:Name="txtSelCount" Text="0 selected / 0 total" Style="{StaticResource BodySmall}" Margin="0,8,0,0"/>

                    <Button x:Name="btnClearFilters" Content="Clear All Filters" Click="btnClearFilters_Click" Margin="0,12,0,0" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderBrush="#333" BorderThickness="1" Padding="6,4"/>

                    <StackPanel Margin="0,24,0,0">
                        <Button x:Name="btnOpenFolder" Content="Open Folder" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <Button x:Name="btnExport" Content="Export Excel" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <Button x:Name="btnSaveArchive" Content="Save to Archive" Click="btnSaveArchive_Click" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <Button x:Name="btnLoadArchive" Content="Load Archive" Click="btnLoadArchive_Click" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <Button x:Name="btnRunAnalysis" Content="Run Analysis (Python)" Click="btnRunAnalysis_Click" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" HorizontalAlignment="Left" ToolTip="수집된 데이터를 바탕으로 분석 스크립트를 실행합니다."/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Version 0.6" Style="{StaticResource BodySmall}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Section -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="Soccerline Smart Crawler" Style="{StaticResource H1}"/>
                <Border Background="{StaticResource BrushStatusSuccess}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v0.6" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- Configuration Card -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Crawler Configuration" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Board" Style="{StaticResource BodySmall}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="comboBoard" SelectedIndex="0" Background="{StaticResource BrushSurfaceCard}" Foreground="White" BorderBrush="#333" Padding="8,4">
                                <ComboBoxItem Content="라커룸"/>
                                <ComboBoxItem Content="축구소식"/>
                                <ComboBoxItem Content="국외게시판"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Page Range" Style="{StaticResource BodySmall}" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtPageRange" Style="{StaticResource ConfigInput}" Text="1 - 1"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Authors (pre-filter, optional)" Style="{StaticResource BodySmall}" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtAuthors" Style="{StaticResource ConfigInput}" ToolTip="쉼표(,)로 구분, 비어있을 경우 전체 수집"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Date Range (optional)" Style="{StaticResource BodySmall}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtDateStart" Grid.Column="0" Style="{StaticResource ConfigInput}" Text="2026-04-01"/>
                                <TextBlock Grid.Column="1" Text="~" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox x:Name="txtDateEnd" Grid.Column="2" Style="{StaticResource ConfigInput}" Text="2026-04-22"/>
                            </Grid>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Results DataGrid -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="Results — 헤더 클릭으로 정렬, 헤더의 ▼ 버튼으로 엑셀 스타일 필터" Style="{StaticResource BodySmall}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="txtGridStatus" Text="" Style="{StaticResource BodySmall}" DockPanel.Dock="Right"/>
                    <TextBlock x:Name="txtArchiveCount" Text="archive: 0" Style="{StaticResource BodySmall}" DockPanel.Dock="Right" Margin="0,0,16,0"/>
                </DockPanel>
                <DataGrid x:Name="grdPosts" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="#0E0E0E"
                          Foreground="White"
                          RowBackground="#151515"
                          AlternatingRowBackground="#1b1b1b"
                          BorderBrush="#333"
                          BorderThickness="1"
                          VerticalGridLinesBrush="#222"
                          HorizontalGridLinesBrush="#222"
                          ColumnHeaderHeight="36"
                          ColumnHeaderStyle="{StaticResource FilterHeaderStyle}">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                        <DataGridTextColumn Binding="{Binding CreatedAt}" Width="140" IsReadOnly="True" SortMemberPath="CreatedAt">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="작성일" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="CreatedAt" Click="FilterButton_Click" Width="20" Height="20" Margin="6,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Title}" Width="*" IsReadOnly="True" SortMemberPath="Title">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="제목" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="Title" Click="FilterButton_Click" Width="20" Height="20" Margin="6,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Author}" Width="120" IsReadOnly="True" SortMemberPath="Author">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="작성자" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="Author" Click="FilterButton_Click" Width="20" Height="20" Margin="6,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AuthorId}" Width="130" IsReadOnly="True" SortMemberPath="AuthorId">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="작성자 ID" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="AuthorId" Click="FilterButton_Click" Width="20" Height="20" Margin="6,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Views}" Width="60" IsReadOnly="True" SortMemberPath="Views">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="조회" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="Views" Click="FilterButton_Click" Width="20" Height="20" Margin="4,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Likes}" Width="60" IsReadOnly="True" SortMemberPath="Likes">
                            <DataGridTextColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="추천" VerticalAlignment="Center"/>
                                    <Button Content="▼" Tag="Likes" Click="FilterButton_Click" Width="20" Height="20" Margin="4,0,0,0" Padding="0" FontSize="9" Background="#333" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Comments.Count}" Width="60" IsReadOnly="True" SortMemberPath="Comments.Count" Header="댓글수"/>
                        <DataGridCheckBoxColumn Header="상세" Binding="{Binding DetailsFetched}" Width="50" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="삭제" Binding="{Binding IsDeleted}" Width="50" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Log Console -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Log" Style="{StaticResource BodySmall}" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="4" Padding="12">
                    <TextBox x:Name="txtLog"
                             FontFamily="Consolas, Courier New"
                             FontSize="12"
                             Foreground="{StaticResource BrushTextSecondary}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             IsUndoEnabled="False"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Text=""/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
